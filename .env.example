# RankNibbler API (free tier: 100 audits/day)
# Get your free API key at https://www.ranknibbler.com/register
RANKNIBBLER_API_KEY=your_ranknibbler_api_key_here

# Server
PORT=3000

# SMTP Email (for sending reports to users)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@email.com
SMTP_PASS=your_app_password
FROM_EMAIL=reports@yourdomain.com
FROM_NAME="SEO Audit Report"
